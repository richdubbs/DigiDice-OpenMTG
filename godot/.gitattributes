# Godot: keep text files with LF line endings on every machine (the editor writes LF).
* text=auto eol=lf

# Binary assets: never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.exe binary
*.pck binary
*.res binary
*.scn binary
