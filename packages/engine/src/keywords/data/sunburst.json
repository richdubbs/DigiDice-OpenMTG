            "countersIf": [
              {
                "if": {
                  "types": [
                    "Creature"
                  ]
                },
                "counters": [
                  {
                    "kind": "+1/+1",
                    "count": {
                      "q": "colorsSpent"
                    }
                  }
                ]
              },
              {
                "if": {
                  "notTypes": [
                    "Creature"
                  ]
                },
                "counters": [
                  {
                    "kind": "charge",
                    "count": {
