          "cond": "chosen",
          "link": "keywordChoice",
          "equals": "$k1.text"
        },
        "then": [
          {
            "op": "effect",
            "duration": "$d",
            "effects": [
              {
                "s": "continuous",
                "affects": "$o",
                "mods": [
                  {
                    "layer": 6,
                    "remove": [
                      "$k1.keyword"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "op": "if",
        "cond": {
          "cond": "chosen",
          "link": "keywordChoice",
          "equals": "$k2.text"
        },
        "then": [
          {
            "op": "effect",
            "duration": "$d",
            "effects": [
              {
                "s": "continuous",
                "affects": "$o",
                "mods": [
                  {
                    "layer": 6,
                    "remove": [
                      "$k2.keyword"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "op": "if",
        "cond": {
          "cond": "chosen",
          "link": "keywordChoice",
          "equals": "$k3.text"
        },
        "then": [
          {
            "op": "effect",
            "duration": "$d",
            "effects": [
              {
                "s": "continuous",
                "affects": "$o",
                "mods": [
                  {
                    "layer": 6,
                    "remove": [
                      "$k3.keyword"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
