# The hosted server's settings (docs/design/m13-hosted-server.md 10.1; docs/ops/hosted.md says what each does). Copy to .env (git-ignored) and fill in
# the secrets: never commit a filled-in copy. Every value here is a placeholder or a default.
#
# Make each secret with:  openssl rand -hex 32

# ---- Secrets (from the environment or a secret store only; never logged)
LEDGER_SECRET=
METRICS_TOKEN=
# Only for the development compose stack: the database's owner role and the service role the server connects as.
POSTGRES_PASSWORD=
OPENMTG_SERVICE_PASSWORD=
# Without compose: the service role's connection string (STORE=postgres). The compose stack builds it from OPENMTG_SERVICE_PASSWORD.
# DATABASE_URL=postgres://openmtg_service:change-me-too@127.0.0.1:5432/openmtg

# ---- Where things are
# The card index folder (the cards package's cache, `npm run cards -- refresh`); the compose stack mounts it read-only at /cards.
CARD_INDEX_DIR=../../.cache/scryfall
# STORE=file          # memory | file | postgres (the image's default is postgres, `npm run hosted`'s is file)
# DATA_DIR=data       # the file store, the run lock and the hide file
# CARD_DATA_DIR=      # the card index as the server reads it (unset: the cards package's default cache)
# MODERATION_WORDS_FILE=   # the word filter's list for names and titles (unset: the short built-in list)

# ---- Network
# PORT=8787
# BIND=127.0.0.1      # outside a container keep the loopback; the compose stack binds 0.0.0.0 behind Caddy
# TRUST_PROXY=        # the reverse proxy's address: when set, only it may connect
# PUBLIC_ORIGINS=     # the https origins of pages that may connect (comma separated, exact: https://play.example.net)
# ALLOW_DESKTOP_ORIGINS=true   # the OpenMTG desktop app's local pages
# METRICS_PORT=9464   # the metrics listener (needs METRICS_TOKEN); never published, never proxied

# ---- Capacity and limits
# WORKERS=            # game workers (default: CPU cores - 1)
# DECK_WORKERS=1
# CAPACITY_UNITS=     # the soft limit of running games, in units (a 1v1 game is 1); CAPACITY_UNITS=1 shows the capacity queue at once
# CAPACITY_QUEUE_MAX=
# CAPACITY_WAIT_MAX_MINUTES=20
# UNITS_1V1=1
# UNITS_POD3=4
# UNITS_POD4=5
# MAX_CONNECTIONS=5000
# MAX_LOBBY=400
# MAX_LISTED=300
# MAX_LOBBY_WATCHERS=2000
# SESSION_RATE=200
# OUTBOUND_BUDGET_MB=256

# ---- Games
# PODS_ENABLED=false  # 3-4 player tables and pod matchmaking
# POD_THREE_AFTER_SECONDS=90
# HOSTED_FORMATS=     # the formats offered (comma separated ids; unset: all)
# CLOCK_DEFAULTS=     # the clocks (see docs/ops/hosted.md)
# DRAIN_MAX_MINUTES=250

# ---- Retention (days)
# RETENTION_LOG_DAYS=90
# RETENTION_LOBBY_DAYS=7
# RETENTION_VOID_DAYS=90
# RETENTION_SESSION_DAYS=30
# RETENTION_SERVER_LOG_DAYS=14

# ---- Logs
# LOG_LEVEL=info      # debug | info | warn | error
